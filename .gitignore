# ── Data ──────────────────────────────────────────────────────────────────────
# Keep directory layout in git; ignore large local files.
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# ── Database ──────────────────────────────────────────────────────────────────
*.duckdb
*.duckdb.wal

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
dist/
build/
*.egg
.Python

# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ── Spark ─────────────────────────────────────────────────────────────────────
derby.log
metastore_db/
spark-warehouse/

# ── macOS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
